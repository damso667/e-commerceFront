{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "polices",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/fonts/**"]
      }
    },
    {
      "name": "ressources",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/**/*.(svg|png|jpg|jpeg|webp|avif)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "identite-boutique",
      "urls": ["/api/parametres"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 2,
        "maxAge": "7d",
        "timeout": "3s"
      }
    },
    {
      "name": "catalogue",
      "urls": ["/api/personne/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 60,
        "maxAge": "1d",
        "timeout": "5s"
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"]
}
