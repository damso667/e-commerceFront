{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/e-commerceFront/browser",
  "rewrites": [
    {
      "source": "/api/:chemin*",
      "destination": "https://ecommerce-api-60sl.onrender.com/api/:chemin*"
    },
    {
      "source": "/actuator/:chemin*",
      "destination": "https://ecommerce-api-60sl.onrender.com/actuator/:chemin*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
